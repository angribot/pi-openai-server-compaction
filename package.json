{
  "name": "pi-openai-server-compaction",
  "version": "0.7.0",
  "private": true,
  "description": "Pi extension for OpenAI Responses Remote compaction with native replay.",
  "keywords": [
    "codex",
    "compaction",
    "openai",
    "pi-extension",
    "pi-package",
    "responses"
  ],
  "homepage": "https://github.com/angribot/pi-openai-server-compaction#readme",
  "bugs": {
    "url": "https://github.com/angribot/pi-openai-server-compaction/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angribot/pi-openai-server-compaction.git"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:offline": "node --experimental-strip-types --test ./tests/*.test.ts",
    "test": "npm run typecheck && npm run test:offline",
    "test:live": "node --experimental-strip-types --test ./tests/live/*-live.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
